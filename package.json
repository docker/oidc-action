{
  "name": "oidc-action",
  "description": "GitHub OIDC action for Docker Hub",
  "version": "1.3.0",
  "author": "Docker, Inc.",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/actions/typescript-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docker/oidc-action.git"
  },
  "bugs": {
    "url": "https://github.com/docker/oidc-action/issues"
  },
  "keywords": [
    "actions",
    "docker",
    "oidc"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "rollup": "^4.65.0",
    "ts-jest": "^29.4.15",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@actions/github": {
      "undici": "^6.29.1"
    },
    "@actions/http-client": {
      "undici": "^6.29.1"
    }
  }
}
